{
  "name": "__APP_NAME__",
  "private": true,
  "scripts": {
    "aoe:cleanup": ".aoe/scripts/cleanup-worktree.sh",
    "aoe:dispatch": ".aoe/scripts/create-dispatch.sh",
    "aoe:send": ".aoe/scripts/send-message.sh",
    "build": "turbo run build",
    "check-types": "turbo run check-types",

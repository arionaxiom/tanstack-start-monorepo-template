{
  "name": "__APP_NAME__",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "clean:node-modules": "node scripts/clean-node-modules.mjs",
    "dev": "turbo run dev",
    "esm:check": "node scripts/verify-esm.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:staged": "lint-staged",
    "lint": "turbo run lint",
    "prepare": "husky",
    "template:init": "node scripts/init-template.mjs",
    "template:init:test": "node scripts/init-template.test.mjs",
    "test": "node scripts/verify-esm.mjs && node scripts/init-template.test.mjs && turbo run test --concurrency=50%",
    "verify": "pnpm format:check && pnpm lint && pnpm check-types && pnpm test && pnpm build"
  },
  "lint-staged": {
    "*.{js,mjs,ts,mts,tsx,json,jsonc,md,css,yaml,yml}": "prettier --write"
  },
  "devDependencies": {
    "@lingui/cli": "^6.6.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.9",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module"
}

    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.14",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module"
